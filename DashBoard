<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Plataforma Operativa Novo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        novo: { 50: '#eff6ff', 100: '#dbeafe', 600: '#1e40af', 700: '#1d4ed8', 800: '#1e3a8a', 900: '#172554' },
                        success: '#10b981', warning: '#f59e0b', danger: '#ef4444'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background: #f3f4f6; }
        .sidebar-link.active { background: #1e3a8a; color: white; border-right: 4px solid #60a5fa; }
        .sidebar-link:hover:not(.active) { background: #eff6ff; color: #1e3a8a; }
        .chart-container { position: relative; height: 300px; width: 100%; }
        .fade-in { animation: fadeIn 0.3s; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .sync-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
        .sync-dot.online { background: #10b981; box-shadow: 0 0 5px #10b981; }
        .hidden-view { display: none !important; }
        .flex-view { display: flex !important; }
        .auth-tab.active { border-bottom: 2px solid #1e40af; color: #1e40af; font-weight: 600; }
    </style>
</head>
<body class="text-gray-800 h-screen overflow-hidden">

    <!-- AUTH VIEW -->
    <div id="auth-view" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-novo-900 to-slate-800 p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden">
            <div class="p-6 bg-novo-800 text-white text-center">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-layer-group text-2xl"></i>
                </div>
                <h1 class="text-xl font-bold">Novo Operativa</h1>
                <p class="text-novo-100 text-sm">Plataforma Integral</p>
            </div>

            <!-- Tabs -->
            <div class="flex border-b border-gray-200">
                <button type="button" onclick="switchTab('email')" id="tab-email" class="flex-1 py-3 text-sm font-medium auth-tab active">
                    <i class="fa-solid fa-envelope mr-2"></i>Correo
                </button>
                <button type="button" onclick="switchTab('document')" id="tab-document" class="flex-1 py-3 text-sm font-medium auth-tab">
                    <i class="fa-solid fa-id-card mr-2"></i>Documento
                </button>
            </div>

            <form onsubmit="handleLogin(event)" class="p-6 space-y-4">
                <!-- Email Field -->
                <div id="field-email">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
                    <input type="email" id="input-email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-novo-600" placeholder="Camilo@novo.com">
                </div>

                <!-- Document Fields -->
                <div id="field-document" class="hidden space-y-3">
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
                            <select id="input-doc-type" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white">
                                <option value="CC">CC</option>
                                <option value="CE">CE</option>
                                <option value="NIT">NIT</option>
                            </select>
                        </div>
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Número</label>
                            <input type="text" id="input-doc-num" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg" placeholder="1000376905">
                        </div>
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
                    <input type="password" id="input-password" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg" placeholder="••••••••">
                </div>

                <!-- Error Message -->
                <div id="error-msg" class="hidden text-red-600 text-sm bg-red-50 p-3 rounded-lg"></div>

                <!-- Login Button -->
                <button type="submit" id="btn-login" class="w-full bg-novo-600 hover:bg-novo-700 text-white font-semibold py-2.5 rounded-lg transition">
                    <i class="fa-solid fa-right-to-bracket mr-2"></i>Ingresar
                </button>

                <!-- Demo Hint -->
                <p class="text-center text-xs text-gray-400">
                    Demo: <strong>Camilo@novo.com</strong> / <strong>123456</strong><br>
                    o CC: <strong>1000376905</strong> / <strong>123456</strong>
                </p>
            </form>
        </div>
    </div>

    <!-- DASHBOARD VIEW -->
    <div id="dashboard-view" class="hidden-view h-screen flex overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-novo-900 text-gray-300 flex flex-col hidden md:flex">
            <div class="p-5 flex items-center gap-3 border-b border-novo-700">
                <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-novo-800 font-bold">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <h1 class="font-bold text-white">Novo Ops</h1>
                    <p class="text-xs text-novo-100">Plataforma Operativa</p>
                </div>
            </div>
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <a href="#" onclick="showSection('dashboard')" class="sidebar-link active flex items-center gap-3 px-3 py-2.5 rounded text-sm">
                    <i class="fa-solid fa-chart-pie w-5"></i> Dashboard
                </a>
                <a href="#" onclick="showSection('talento')" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm">
                    <i class="fa-solid fa-users w-5"></i> Talento Humano
                </a>
                <a href="#" onclick="showSection('eventos')" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm">
                    <i class="fa-solid fa-calendar-days w-5"></i> Eventos
                </a>
                <a href="#" onclick="showSection('inventario')" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm">
                    <i class="fa-solid fa-box-open w-5"></i> Inventario
                </a>
            </nav>
            <div class="p-4 border-t border-novo-700">
                <div class="flex items-center gap-3">
                    <img id="user-avatar" class="w-9 h-9 rounded-full border-2 border-novo-500" src="https://ui-avatars.com/api/?name=Camilo&background=fff&color=1e3a8a">
                    <div>
                        <p id="user-name" class="text-sm font-medium text-white">Camilo</p>
                        <p id="user-role" class="text-xs text-novo-200">Administrador</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            <!-- Header -->
            <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6">
                <h2 id="page-title" class="text-xl font-bold text-gray-800">Panel de Control</h2>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="sync-dot online"></span>
                        <span>Conectado</span>
                    </div>
                    <button onclick="logout()" class="p-2 text-gray-400 hover:text-danger">
                        <i class="fa-solid fa-right-from-bracket text-lg"></i>
                    </button>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto bg-gray-50 p-6">
                
                <!-- DASHBOARD SECTION -->
                <section id="section-dashboard" class="fade-in space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <p class="text-sm text-gray-500">Empresas Activas</p>
                            <h3 class="text-3xl font-bold text-gray-800">24</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <p class="text-sm text-gray-500">Personal Disponible</p>
                            <h3 class="text-3xl font-bold text-gray-800">3,456</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <p class="text-sm text-gray-500">Eventos este mes</p>
                            <h3 class="text-3xl font-bold text-gray-800">45</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <p class="text-sm text-gray-500">Sync Pendiente</p>
                            <h3 class="text-3xl font-bold text-gray-800">23</h3>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <h4 class="font-bold mb-4">Operación Mensual</h4>
                            <div class="chart-container"><canvas id="chartOps"></canvas></div>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm">
                            <h4 class="font-bold mb-4">Estado Expedientes</h4>
                            <div class="chart-container"><canvas id="chartStatus"></canvas></div>
                        </div>
                    </div>
                </section>

                <!-- TALENTO SECTION -->
                <section id="section-talento" class="hidden fade-in">
                    <div class="bg-white p-5 rounded-xl shadow-sm">
                        <h3 class="text-lg font-bold mb-4">Base de Personal</h3>
                        <table class="w-full text-sm">
                            <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                                <tr><th class="px-4 py-2 text-left">Documento</th><th class="px-4 py-2 text-left">Nombre</th><th class="px-4 py-2 text-left">Estado</th></tr>
                            </thead>
                            <tbody class="divide-y">
                                <tr><td class="px-4 py-2">1000376905</td><td class="px-4 py-2">Camilo Admin</td><td class="px-4 py-2"><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs">Activo</span></td></tr>
                                <tr><td class="px-4 py-2">1029384756</td><td class="px-4 py-2">Carlos Martínez</td><td class="px-4 py-2"><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs">Activo</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- EVENTOS SECTION -->
                <section id="section-eventos" class="hidden fade-in">
                    <div class="bg-white p-5 rounded-xl shadow-sm">
                        <h3 class="text-lg font-bold mb-4">Eventos Activos</h3>
                        <div class="space-y-3">
                            <div class="border p-4 rounded-lg">
                                <h4 class="font-bold">Festival de Verano 2026</h4>
                                <p class="text-sm text-gray-500">Cartagena | 15-17 Mayo</p>
                                <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs">En Curso</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- INVENTARIO SECTION -->
                <section id="section-inventario" class="hidden fade-in">
                    <div class="bg-white p-5 rounded-xl shadow-sm">
                        <h3 class="text-lg font-bold mb-4">Inventario</h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                            <div class="p-3 bg-gray-50 rounded"><p class="text-2xl font-bold">5,678</p><p class="text-xs text-gray-500">Total</p></div>
                            <div class="p-3 bg-gray-50 rounded"><p class="text-2xl font-bold text-purple-600">1,234</p><p class="text-xs text-gray-500">En Campo</p></div>
                            <div class="p-3 bg-gray-50 rounded"><p class="text-2xl font-bold text-warning">89</p><p class="text-xs text-gray-500">Pendientes</p></div>
                            <div class="p-3 bg-gray-50 rounded"><p class="text-2xl font-bold text-danger">12</p><p class="text-xs text-gray-500">Bajas</p></div>
                        </div>
                    </div>
                </section>

            </main>
        </div>
    </div>

    <script>
        // === CREDENCIALES CONFIGURADAS ===
        const VALID_CREDENTIALS = {
            email: { user: 'camilo@novo.com', pass: '123456' },
            document: { type: 'CC', num: '1000376905', pass: '123456' }
        };

        // === AUTH FUNCTIONS ===
        function switchTab(method) {
            document.getElementById('tab-email').classList.toggle('active', method === 'email');
            document.getElementById('tab-document').classList.toggle('active', method === 'document');
            document.getElementById('field-email').classList.toggle('hidden', method !== 'email');
            document.getElementById('field-document').classList.toggle('hidden', method === 'email');
        }

        function showError(msg) {
            const el = document.getElementById('error-msg');
            el.textContent = msg;
            el.classList.remove('hidden');
        }

        function hideError() {
            document.getElementById('error-msg').classList.add('hidden');
        }

        function handleLogin(e) {
            e.preventDefault();
            hideError();
            
            const isEmailMode = !document.getElementById('field-email').classList.contains('hidden');
            const password = document.getElementById('input-password').value;
            
            let valid = false;
            
            if (isEmailMode) {
                const email = document.getElementById('input-email').value.trim().toLowerCase();
                valid = (email === VALID_CREDENTIALS.email.user && password === VALID_CREDENTIALS.email.pass);
            } else {
                const type = document.getElementById('input-doc-type').value;
                const num = document.getElementById('input-doc-num').value.trim();
                valid = (type === VALID_CREDENTIALS.document.type && 
                        num === VALID_CREDENTIALS.document.num && 
                        password === VALID_CREDENTIALS.document.pass);
            }
            
            if (valid) {
                // Save session
                sessionStorage.setItem('novo_user', JSON.stringify({
                    name: 'Camilo',
                    role: 'Administrador',
                    avatar: 'https://ui-avatars.com/api/?name=Camilo&background=fff&color=1e3a8a'
                }));
                enterDashboard();
            } else {
                showError('Credenciales inválidas. Verifica tu correo/documento y contraseña.');
            }
        }

        function enterDashboard() {
            // Hide auth, show dashboard
            document.getElementById('auth-view').classList.add('hidden-view');
            document.getElementById('auth-view').classList.remove('flex');
            document.getElementById('dashboard-view').classList.remove('hidden-view');
            document.getElementById('dashboard-view').classList.add('flex-view');
            
            // Load user info
            const user = JSON.parse(sessionStorage.getItem('novo_user'));
            if (user) {
                document.getElementById('user-name').textContent = user.name;
                document.getElementById('user-avatar').src = user.avatar;
            }
            
            // Initialize charts
            initCharts();
        }

        function logout() {
            sessionStorage.removeItem('novo_user');
            location.reload();
        }

        function checkSession() {
            const saved = sessionStorage.getItem('novo_user');
            if (saved) {
                enterDashboard();
            }
        }

        // === DASHBOARD NAVIGATION ===
        function showSection(id) {
            // Hide all sections
            ['dashboard', 'talento', 'eventos', 'inventario'].forEach(s => {
                document.getElementById('section-' + s).classList.add('hidden');
            });
            // Show target
            document.getElementById('section-' + id).classList.remove('hidden');
            
            // Update title
            const titles = {
                'dashboard': 'Panel de Control',
                'talento': 'Talento Humano',
                'eventos': 'Eventos Operativos',
                'inventario': 'Gestión de Inventario'
            };
            document.getElementById('page-title').textContent = titles[id];
        }

        // === CHARTS ===
        function initCharts() {
            // Chart 1: Operations
            const ctx1 = document.getElementById('chartOps');
            if (ctx1 && !ctx1.chart) {
                ctx1.chart = new Chart(ctx1.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Ene','Feb','Mar','Abr','May','Jun'],
                        datasets: [
                            { label: 'Eventos', data: [12,19,3,5,2,3], backgroundColor: '#1e40af' },
                            { label: 'Personal', data: [240,350,150,220,450,500], backgroundColor: '#10b981' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
            
            // Chart 2: Status
            const ctx2 = document.getElementById('chartStatus');
            if (ctx2 && !ctx2.chart) {
                ctx2.chart = new Chart(ctx2.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Aprobado','Pendiente','Vencido'],
                        datasets: [{ data: [78, 15, 7], backgroundColor: ['#10b981','#f59e0b','#ef4444'] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                });
            }
        }

        // === INIT ===
        window.addEventListener('DOMContentLoaded', function() {
            checkSession();
        });
    </script>
</body>
</html>
