<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Plataforma Operativa Novo</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="css/styles.css">
    
    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        novo: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            600: '#1e40af',
                            700: '#1d4ed8',
                            800: '#1e3a8a',
                            900: '#172554',
                        },
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                        info: '#64748b'
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="text-gray-800 h-screen overflow-hidden">

    <!-- AUTH VIEW -->
    <div id="auth-view" class="fixed inset-0 bg-gradient-to-br from-slate-900 via-novo-900 to-slate-800 z-50 items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden">
            <div class="p-6 bg-novo-800 text-white text-center">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-layer-group text-2xl"></i>
                </div>
                <h1 class="text-xl font-bold">Novo Operativa</h1>
                <p class="text-novo-100 text-sm mt-1">Plataforma Integral</p>
            </div>

            <!-- Tabs -->
            <div class="flex border-b border-gray-200">
                <button type="button" onclick="switchAuthTab('email')" id="tab-email" class="flex-1 py-3 text-sm font-medium text-center auth-tab active">
                    <i class="fa-solid fa-envelope mr-2"></i>Correo
                </button>
                <button type="button" onclick="switchAuthTab('document')" id="tab-document" class="flex-1 py-3 text-sm font-medium text-center auth-tab">
                    <i class="fa-solid fa-id-card mr-2"></i>Documento
                </button>
            </div>

            <form onsubmit="handleLogin(event)" class="p-6 space-y-4">
                <!-- Email Field -->
                <div id="field-email">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Correo</label>
                    <input type="email" id="input-email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg" placeholder="Camilo@novo.com">
                </div>

                <!-- Document Fields -->
                <div id="field-document" class="hidden space-y-3">
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
                            <select id="input-doc-type" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg">
                                <option value="CC">CC</option>
                                <option value="CE">CE</option>
                            </select>
                        </div>
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Número</label>
                            <input type="text" id="input-doc-num" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg" placeholder="1000376905">
                        </div>
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
                    <input type="password" id="input-password" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg" placeholder="••••••••">
                </div>

                <!-- Error Message -->
                <div id="error-msg" class="hidden text-red-600 text-sm bg-red-50 p-3 rounded-lg"></div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-novo-600 hover:bg-novo-700 text-white font-semibold py-2.5 rounded-lg">
                    <i class="fa-solid fa-right-to-bracket mr-2"></i>Ingresar
                </button>

                <p class="text-center text-xs text-gray-400">
                    Demo: Camilo@novo.com / 123456<br>CC: 1000376905 / 123456
                </p>
            </form>
        </div>
    </div>

    <!-- DASHBOARD VIEW -->
    <div id="dashboard-view" class="h-screen flex overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-novo-900 text-gray-300 hidden md:flex flex-col">
            <div class="p-5 border-b border-novo-700">
                <h1 class="font-bold text-white">Novo Ops</h1>
            </div>
            <nav class="flex-1 p-3 space-y-1">
                <a href="#" onclick="showSection('dashboard')" class="sidebar-link active flex items-center gap-3 px-3 py-2 rounded text-sm">
                    <i class="fa-solid fa-chart-pie"></i> Dashboard
                </a>
                <a href="#" onclick="showSection('talento')" class="sidebar-link flex items-center gap-3 px-3 py-2 rounded text-sm">
                    <i class="fa-solid fa-users"></i> Talento Humano
                </a>
            </nav>
            <div class="p-4 border-t border-novo-700">
                <button onclick="logout()" class="text-sm text-white hover:text-novo-200">
                    <i class="fa-solid fa-right-from-bracket mr-2"></i>Cerrar Sesión
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            <header class="bg-white border-b h-16 flex items-center justify-between px-6">
                <h2 class="text-xl font-bold">Panel de Control</h2>
                <span class="text-sm text-gray-500">Bienvenido</span>
            </header>
            
            <main class="flex-1 overflow-y-auto bg-gray-50 p-6">
                <section id="section-dashboard" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div class="bg-white p-5 rounded-xl shadow">
                            <p class="text-sm text-gray-500">Empresas</p>
                            <h3 class="text-3xl font-bold">24</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow">
                            <p class="text-sm text-gray-500">Personal</p>
                            <h3 class="text-3xl font-bold">3,456</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow">
                            <p class="text-sm text-gray-500">Eventos</p>
                            <h3 class="text-3xl font-bold">45</h3>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow">
                            <p class="text-sm text-gray-500">Sync</p>
                            <h3 class="text-3xl font-bold text-success">OK</h3>
                        </div>
                    </div>
                </section>

                <section id="section-talento" class="hidden space-y-6">
                    <div class="bg-white p-5 rounded-xl shadow">
                        <h3 class="text-lg font-bold mb-4">Talento Humano</h3>
                        <p>Contenido de Talento Humano</p>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- JavaScript Modules -->
    <script src="js/auth.js"></script>
    <script src="js/dashboard.js"></script>
</body>
</html>
